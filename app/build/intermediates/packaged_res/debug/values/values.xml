<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="buddy_bg">#FF121212</color>
    <color name="buddy_error">#FFFF5252</color>
    <color name="buddy_primary">#FF00E5FF</color>
    <color name="buddy_primary_dark">#FF00B8D4</color>
    <color name="buddy_surface">#FF1E1E1E</color>
    <color name="buddy_text">#FFE0E0E0</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Buddy</string>
    <style name="Theme.Buddy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/buddy_primary</item>
        <item name="colorPrimaryDark">@color/buddy_primary_dark</item>
        <item name="colorAccent">@color/buddy_primary</item>
        <item name="android:statusBarColor">@color/buddy_bg</item>
        <item name="android:navigationBarColor">@color/buddy_bg</item>
        <item name="android:windowBackground">@color/buddy_bg</item>
        <item name="android:textColor">@color/buddy_text</item>
    </style>
    <style name="Theme.Buddy.Splash" parent="Theme.Buddy">
        <item name="android:windowBackground">@color/buddy_bg</item>
    </style>
